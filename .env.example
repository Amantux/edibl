# Edibl configuration — EXAMPLE ONLY.
#
# Copy to .env and edit. Every value here is a placeholder: this file
# contains NO usable secrets and is safe to commit.
#
# Generated by tools/gen_config_docs.py from the settings inventory.
# Do not edit by hand — CI regenerates and diffs it.
#
# Full reference, including security impact: docs/configuration.md

# --- Storage -------------------------------------------------------
# Directory for the SQLite database, uploads and persisted secrets.
#EDIBL_DATA_DIR=./data

# Full SQLAlchemy URL. Blank = SQLite inside DATA_DIR. Postgres is
# supported: postgresql+psycopg://user:pass@host:5432/dbname.
# SECRET. Also supported: EDIBL_DATABASE_URL_FILE=/run/secrets/... (Docker secrets)
#EDIBL_DATABASE_URL=

# One-shot: when DATABASE_URL points at an EMPTY Postgres and a local SQLite
# database exists, copy the SQLite data across at startup.
#EDIBL_MIGRATE_FROM_SQLITE=false

# Home Assistant only: discover the Shared PostgreSQL add-on and use a
# database it provisions for Edibl. Ignored when DATABASE_URL is set.
#EDIBL_USE_SHARED_POSTGRES=false

# Token for the Shared PostgreSQL add-on's provisioning API. Blank
# auto-obtains it via discovery.
# SECRET. Also supported: EDIBL_POSTGRES_PROVISION_TOKEN_FILE=/run/secrets/... (Docker secrets)
#EDIBL_POSTGRES_PROVISION_TOKEN=

# --- Security ------------------------------------------------------
# JWT signing key. Blank = generated once and persisted in DATA_DIR.
# Deliberately has no add-on option: a key that changed per boot would log
# every user out and void every API token on each restart.
# SECRET. Also supported: EDIBL_SECRET_KEY_FILE=/run/secrets/... (Docker secrets)
#EDIBL_SECRET_KEY=

# How long an issued token stays valid, in hours.
#EDIBL_JWT_HOURS=72

# Bind every request to a single local user. ONLY safe behind an
# authenticating proxy such as Home Assistant ingress.
#EDIBL_DISABLE_AUTH=false

# Allow anyone who can reach the app to create an account.
#EDIBL_ALLOW_REGISTRATION=true

# Minimum password length enforced on register / change-password.
#EDIBL_MIN_PASSWORD_LENGTH=8

# Run the in-process background-job worker thread (async AI tooling).
#EDIBL_WORKER_ENABLED=true

# Seed a new database with the default locations, units and categories.
#EDIBL_SEED_DEFAULTS=true

# --- Network & proxy -----------------------------------------------
# HTTP port for the app.
#EDIBL_PORT=7746

# Comma-separated origins allowed to make credentialed cross-origin
# requests. Empty = same-origin only (correct for normal deployments).
#EDIBL_CORS_ORIGINS=

# How many reverse proxies sit in front. 0 = do not trust X-Forwarded-*
# headers at all.
#EDIBL_PROXY_HOPS=0

# Enable request rate limiting (disabled automatically under tests).
#EDIBL_RATELIMIT_ENABLED=true

# --- LLM assistant -------------------------------------------------
# Which LLM backend the assistant uses. Blank = rules only.
#EDIBL_LLM_PROVIDER=

# Base URL of the LLM server (local Ollama, an OpenAI-compatible gateway, or
# blank for the provider default).
#EDIBL_LLM_BASE_URL=

# API key for the configured LLM provider.
# SECRET. Also supported: EDIBL_LLM_API_KEY_FILE=/run/secrets/... (Docker secrets)
#EDIBL_LLM_API_KEY=

# Model name for the configured LLM provider.
#EDIBL_LLM_MODEL=

# Only for the `homeassistant` provider: which HA conversation agent to
# target (e.g. conversation.ollama). Blank = HA's default agent.
#EDIBL_LLM_AGENT_ID=

# Per-request timeout for LLM provider calls, in seconds.
#EDIBL_LLM_TIMEOUT=60

# Maximum tool-calling rounds the assistant may take per message.
#EDIBL_LLM_MAX_STEPS=6

# Auto-categorization: a proposal at/above this model-reported confidence is
# applied automatically; below it goes to review.
#EDIBL_AI_CONFIDENCE_THRESHOLD=0.8

# Ollama API key (ollama.com) for the hosted web search used to write
# product descriptions. Blank = enrichment is off.
# SECRET. Also supported: EDIBL_OLLAMA_SEARCH_KEY_FILE=/run/secrets/... (Docker secrets)
#EDIBL_OLLAMA_SEARCH_KEY=

# --- Barcode enrichment --------------------------------------------
# Look an unknown scanned barcode up in Open Food Facts. Off by default
# because it makes outbound network calls.
#EDIBL_BARCODE_LOOKUP=false

# Product barcode database for non-food codes.
#EDIBL_BARCODE_DB_URL=https://api.upcitemdb.com/prod/trial/lookup

# API key for the barcode database. Blank uses the keyless trial tier.
# SECRET. Also supported: EDIBL_BARCODE_DB_KEY_FILE=/run/secrets/... (Docker secrets)
#EDIBL_BARCODE_DB_KEY=

# --- Companion apps ------------------------------------------------
# Base URL of a companion myMeal instance. Blank disables the integration.
# Also settable in the UI, which is remembered.
#EDIBL_MYMEAL_URL=

# API token Edibl presents to myMeal.
# SECRET. Also supported: EDIBL_MYMEAL_TOKEN_FILE=/run/secrets/... (Docker secrets)
#EDIBL_MYMEAL_TOKEN=

# Base URL of a companion HomeHoard instance. Blank disables it.
#EDIBL_HOMEHOARD_URL=

# API token Edibl presents to HomeHoard.
# SECRET. Also supported: EDIBL_HOMEHOARD_TOKEN_FILE=/run/secrets/... (Docker secrets)
#EDIBL_HOMEHOARD_TOKEN=

# --- MCP (Home Assistant Assist) -----------------------------------
# Run the MCP server so Home Assistant Assist can use Edibl as a tool.
#EDIBL_MCP_ENABLED=true

# Bind address for the MCP server.
#EDIBL_MCP_HOST=0.0.0.0

# Port for the MCP server (SSE).
#EDIBL_MCP_PORT=7767

# Backend API URL the MCP server calls. Blank = derived from PORT.
#EDIBL_MCP_API=

# Token the MCP server uses when app auth is enabled.
# SECRET. Also supported: EDIBL_MCP_API_TOKEN_FILE=/run/secrets/... (Docker secrets)
#EDIBL_MCP_API_TOKEN=

# Bearer token Home Assistant must present to reach the MCP server.
# SECRET. Also supported: EDIBL_MCP_SERVER_TOKEN_FILE=/run/secrets/... (Docker secrets)
#EDIBL_MCP_SERVER_TOKEN=

# Reach the MCP server from OUTSIDE Home Assistant. When on, every request
# must present a Full- or MCP-scoped API key, and the server refuses to
# start until such a key exists — so it is never open.
#EDIBL_MCP_EXPOSE_EXTERNAL=false

# --- Serving & misc ------------------------------------------------
# Maximum upload size in MB.
#EDIBL_MAX_UPLOAD_MB=25

# Currency code used to display prices (e.g. usd, eur, gbp).
#EDIBL_CURRENCY=usd

# Path to the built SPA. Blank = the location baked into the image.
#EDIBL_FRONTEND_DIST=

# Flask debug mode. NEVER enable in production — it exposes an interactive
# debugger that executes arbitrary code.
#EDIBL_DEBUG=false

# --- Logging -------------------------------------------------------
# Application log level. Applies to both the app and gunicorn.
#EDIBL_LOG_LEVEL=INFO

# Log a line for any request slower than this many milliseconds. 0 logs
# every request, which fills the log on a busy instance — the gunicorn
# access log already covers the ordinary case.
#EDIBL_SLOW_REQUEST_MS=1000

# --- docker-compose only ---------------------------------------
# Host address the MCP port is published on. Not read by the app: it is
# consumed by docker-compose.yml when mapping the port. 127.0.0.1 keeps
# MCP reachable only from this host; 0.0.0.0 exposes it on the LAN, which
# requires EDIBL_MCP_SERVER_TOKEN to be set.
#EDIBL_MCP_BIND=127.0.0.1
